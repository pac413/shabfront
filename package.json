{
  "name": "shabbat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite preview",
    "serve-prerender": "npm run build && http-server dist",
    "type-check": "vue-tsc --noEmit --composite false",
    "lint": "eslint --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore --fix src",
    "generate:graphql": "graphql-codegen --require dotenv/config --config ./codegen.yml",
    "upload:translations": "localazy upload -k localazy.keys.json",
    "download:translations": "localazy download -k localazy.keys.json"
  },
